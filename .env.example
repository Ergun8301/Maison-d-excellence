# ---------------------------------------------------------------------------
# MAISONS D'EXCELLENCE — variables d'environnement
# Copier ce fichier en `.env.local` pour le développement, et renseigner les
# mêmes clés dans Vercel (Settings > Environment Variables) pour la production.
# ---------------------------------------------------------------------------

# URL canonique du site (SEO, sitemap, JSON-LD). Sans slash final.
NEXT_PUBLIC_SITE_URL=https://maisons-excellence.vercel.app

# --- Envoi des formulaires -------------------------------------------------
# Renseigner UNE seule des deux clés. Resend est le choix retenu.
#
# Resend : créer un compte gratuit sur resend.com avec l'adresse du client,
# puis API Keys > Create API Key. 3 000 mails/mois, sans carte bancaire.
RESEND_API_KEY=

# Repli sans création de compte : saisir une adresse sur web3forms.com,
# la clé arrive par e-mail en 30 secondes. 250 mails/mois.
WEB3FORMS_ACCESS_KEY=

# Destinataire des demandes. Par défaut : l'adresse du dirigeant.
CONTACT_TO=aykut.atak@sfr.fr

# Expéditeur. Tant que le domaine définitif n'est pas vérifié chez Resend,
# laisser vide : `onboarding@resend.dev` est utilisé, ce qui fonctionne
# puisque l'on écrit à l'adresse propriétaire du compte Resend.
# Une fois le domaine vérifié : "Maisons d'Excellence <contact@ledomaine.fr>"
MAIL_FROM=
